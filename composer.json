{
    "name": "al_imran/runtime-feature-toggle",
    "description": "A runtime feature engine for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Al IMRAN",
            "email": "alimran.edx@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Imran\\RuntimeFeatureToggle\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Imran\\RuntimeFeatureToggle\\Providers\\FeatureServiceProvider"
            ],
            "aliases": {
                "Feature": "Imran\\RuntimeFeatureToggle\\Facades\\Feature"
            }
        }
    }
}